{
  "name": "@dshit/style-dictionary",
  "version": "1.0.0",
  "description": "Style Dictionary configuration for design token management",
  "type": "module",
  "scripts": {
    "build": "style-dictionary build",
    "build:watch": "style-dictionary build --watch",
    "clean": "rm -rf dist tokens",
    "tokens:json": "style-dictionary build --output-path tokens --formatter json",
    "tokens:css": "style-dictionary build --output-path tokens --formatter css"
  },
  "dependencies": {
    "style-dictionary": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  }
}
